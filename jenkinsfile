pipeline {
    agent any

    environment {
        BUILD_VERSION = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git credentialsId: 'gitrepo',
                    url: 'https://github.com/swetha-200160/python-.git'
            }
        }

        stage('Install Dependencies & Run Tests') {
            steps {
                bat '''
                python -m pip install --upgrade pip
                pip install -r requirements.txt
                pytest --cov=. --cov-report=xml
                '''
            }
        }

      stage('SonarQube Analysis') {
    steps {
        script {
            def scannerHome = tool 'SonarScanner'
            withSonarQubeEnv('SonarQube') {
                bat """
                "${scannerHome}\\bin\\sonar-scanner.bat" ^
                -Dsonar.projectKey=python-country-app ^
                -Dsonar.projectBaseDir="%WORKSPACE%" ^
                -Dsonar.sources=app.py ^
                -Dsonar.tests=test_app.py ^
                -Dsonar.test.inclusions=**/test_*.py ^
                -Dsonar.python.coverage.reportPaths=coverage.xml ^
                -Dsonar.exclusions=**/*.png,.vscode/**,**/*.zip,coverage.xml,.coverage
                """
            }
        }
    }
}


        stage('Package Build') {
            steps {
                bat """
                if exist python-country-app-%BUILD_VERSION%.zip del python-country-app-%BUILD_VERSION%.zip

                powershell -Command "Compress-Archive -Force -Path app.py,requirements.txt,Dockerfile,README.md,test_app.py -DestinationPath python-country-app-%BUILD_VERSION%.zip"

                dir python-country-app-%BUILD_VERSION%.zip
                """
            }
        }

        stage('Build Docker Image') {
            steps {
                bat "docker build -t python-country-app:%BUILD_VERSION% ."
            }
        }

        stage('Deploy Application') {
            steps {
                bat """
                docker rm -f python-country-app 2>NUL || exit 0
                docker run -d -p 5000:5000 --name python-country-app python-country-app:%BUILD_VERSION%
                """
            }
        }
    }
}
